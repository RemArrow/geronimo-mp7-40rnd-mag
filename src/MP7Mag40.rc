// MP7Mag40.dll resources: the encrypted assets and the version/credits block.
#include "version.h"

// The magazine's runtime assets as one encrypted payload. build.bat first runs tools\pack over
// Assets\ (generated from the model by tools\prepare_mag.py, not in the repo): every asset is
// AES-256-GCM encrypted with a per-build key, so the DLL holds no extractable PNG or OBJ
// (src\payload.h).
DATA RCDATA "build\\gen\\payload.bin"

// Shown in the DLL's Properties > Details in Windows.
1 VERSIONINFO
FILEVERSION MP7MAG40_VERSION_NUM
PRODUCTVERSION MP7MAG40_VERSION_NUM
FILEFLAGSMASK 0x3F
FILEFLAGS 0x0
FILEOS 0x40004
FILETYPE 0x2
FILESUBTYPE 0x0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "RemArrow"
            VALUE "FileDescription", "MP7 40-Round Magazine - GML plugin for Geronimo"
            VALUE "FileVersion", MP7MAG40_VERSION
            VALUE "InternalName", "MP7Mag40"
            VALUE "OriginalFilename", "MP7Mag40.dll"
            VALUE "ProductName", "MP7 40-Round Magazine"
            VALUE "ProductVersion", MP7MAG40_VERSION
            VALUE "LegalCopyright", MP7MAG40_MODEL_CREDIT ". Plugin code by RemArrow."
            VALUE "Comments", "Model: HK MP7 SMG by Alpooo on CGTrader, Royalty Free License (no AI). Not affiliated with or endorsed by Alpooo, CGTrader, Heckler & Koch or Dark Matter Studios."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
